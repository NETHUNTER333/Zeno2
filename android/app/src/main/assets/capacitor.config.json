{
	"appId": "app.kinich.android",
	"appName": "Kinich",
	"webDir": "dist",
	"android": {
		"allowMixedContent": true,
		"captureInput": true,
		"webContentsDebuggingEnabled": false,
		"backgroundColor": "#09090b"
	},
	"server": {
		"androidScheme": "https"
	},
	"plugins": {
		"FirebaseAuthentication": {
			"skipNativeAuth": true,
			"providers": [
				"google.com"
			]
		}
	}
}
