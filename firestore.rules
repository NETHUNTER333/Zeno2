rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    function incoming() {
      return request.resource.data;
    }
    function existing() {
      return resource.data;
    }
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'email']) &&
        data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'createdAt', 'updatedAt']) &&
        data.uid is string && data.uid == userId && data.uid.size() <= 128 &&
        data.email is string && data.email.size() <= 200 &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500)) &&
        (!('createdAt' in data) || data.createdAt is number) &&
        (!('updatedAt' in data) || data.updatedAt is number);
    }

    function isValidChatThread(data, userId, threadId) {
      return data.keys().hasAll(['id', 'userId', 'title', 'createdAt', 'messages']) &&
        data.keys().hasOnly(['id', 'userId', 'title', 'createdAt', 'updatedAt', 'messages', 'preview']) &&
        data.id is string && data.id == threadId && data.id.size() <= 128 &&
        data.userId is string && data.userId == userId && data.userId.size() <= 128 &&
        data.title is string && data.title.size() <= 200 &&
        data.createdAt is number &&
        (!('updatedAt' in data) || data.updatedAt is number) &&
        (!('preview' in data) || (data.preview is string && data.preview.size() <= 500)) &&
        data.messages is list && data.messages.size() <= 500;
    }

    function isValidSavedBookmark(data, userId, bookmarkId) {
      return data.keys().hasAll(['id', 'userId', 'threadId', 'messageId', 'role', 'snippet', 'threadTitle', 'savedAt']) &&
        data.keys().hasOnly(['id', 'userId', 'threadId', 'messageId', 'role', 'snippet', 'threadTitle', 'savedAt']) &&
        data.id is string && data.id == bookmarkId && data.id.size() <= 128 &&
        data.userId is string && data.userId == userId && data.userId.size() <= 128 &&
        isValidId(data.threadId) &&
        isValidId(data.messageId) &&
        data.role in ['user', 'assistant'] &&
        data.snippet is string && data.snippet.size() <= 2000 &&
        data.threadTitle is string && data.threadTitle.size() <= 200 &&
        data.savedAt is number;
    }

    function isValidSharedThread(data, shareId) {
      return data.keys().hasAll(['id', 'ownerId', 'title', 'createdAt', 'messages']) &&
        data.keys().hasOnly(['id', 'ownerId', 'title', 'createdAt', 'messages']) &&
        data.id is string && data.id == shareId && data.id.size() <= 128 &&
        data.ownerId is string && data.ownerId.size() <= 128 &&
        data.title is string && data.title.size() <= 200 &&
        data.createdAt is number &&
        data.messages is list && data.messages.size() <= 200;
    }

    function isValidVaultItem(data, userId, itemId) {
      return data.keys().hasAll(['id', 'userId', 'title', 'content', 'collectionId', 'sourceType', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly([
          'id', 'userId', 'type', 'title', 'subject', 'chapter', 'tags',
          'sourceUrl', 'timestamps', 'content', 'summary', 'collectionId',
          'sourceType', 'isPinned', 'relatedItemIds', 'sageNote',
          'organizedBySage', 'createdAt', 'lastReviewedAt', 'updatedAt'
        ]) &&
        data.id is string && data.id == itemId && data.id.size() <= 128 &&
        data.userId is string && data.userId == userId && data.userId.size() <= 128 &&
        data.title is string && data.title.size() <= 200 &&
        data.content is string && data.content.size() <= 24000 &&
        (!('type' in data) || (data.type is string && data.type.size() <= 40)) &&
        (!('subject' in data) || (data.subject is string && data.subject.size() <= 120)) &&
        (!('chapter' in data) || (data.chapter is string && data.chapter.size() <= 160)) &&
        (!('sourceUrl' in data) || (data.sourceUrl is string && data.sourceUrl.size() <= 2048)) &&
        (!('timestamps' in data) || (data.timestamps is list && data.timestamps.size() <= 500)) &&
        (!('summary' in data) || (data.summary is string && data.summary.size() <= 500)) &&
        isValidId(data.collectionId) &&
        data.sourceType is string && data.sourceType.size() <= 40 &&
        (!('tags' in data) || (data.tags is list && data.tags.size() <= 20)) &&
        (!('isPinned' in data) || data.isPinned is bool) &&
        (!('relatedItemIds' in data) || (data.relatedItemIds is list && data.relatedItemIds.size() <= 30)) &&
        (!('sageNote' in data) || (data.sageNote is string && data.sageNote.size() <= 1000)) &&
        (!('organizedBySage' in data) || data.organizedBySage is bool) &&
        data.createdAt is number &&
        (!('lastReviewedAt' in data) || data.lastReviewedAt is number) &&
        data.updatedAt is number;
    }

    function isValidAgentMemory(data, userId, agentId) {
      return data.keys().hasAll(['agentId', 'userId', 'facts', 'updatedAt']) &&
        data.keys().hasOnly(['agentId', 'userId', 'facts', 'updatedAt']) &&
        data.agentId is string && data.agentId == agentId && data.agentId.size() <= 64 &&
        data.userId is string && data.userId == userId && data.userId.size() <= 128 &&
        data.facts is list && data.facts.size() <= 50 &&
        data.updatedAt is number;
    }

    function isValidAgentUsage(data, userId, usageId) {
      return data.keys().hasAll(['id', 'userId', 'agentId', 'date', 'totalTokens', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'userId', 'agentId', 'date', 'promptTokens', 'completionTokens', 'totalTokens', 'callsCount', 'updatedAt']) &&
        data.id is string && data.id == usageId && data.id.size() <= 128 &&
        data.userId is string && data.userId == userId && data.userId.size() <= 128 &&
        data.agentId is string && data.agentId.size() <= 64 &&
        data.date is string && data.date.size() <= 32 &&
        data.totalTokens is number && data.totalTokens >= 0 &&
        data.updatedAt is number;
    }

    function isValidRecallCard(data, userId, cardId) {
      return data.keys().hasAll(['id', 'userId', 'front', 'back', 'dueAt', 'createdAt']) &&
        data.id is string && data.id == cardId && data.id.size() <= 128 &&
        data.userId is string && data.userId == userId && data.userId.size() <= 128 &&
        data.front is string && data.front.size() <= 2000 &&
        data.back is string && data.back.size() <= 5000 &&
        data.dueAt is number &&
        data.createdAt is number;
    }

    function isValidStudyPlan(data, userId, planId) {
      return data.keys().hasAll(['id', 'userId', 'examName', 'examDate', 'subjects', 'days', 'createdAt']) &&
        data.id is string && data.id == planId && data.id.size() <= 128 &&
        data.userId is string && data.userId == userId && data.userId.size() <= 128 &&
        data.examName is string && data.examName.size() <= 200 &&
        data.examDate is string && data.examDate.size() <= 32 &&
        data.subjects is list && data.subjects.size() <= 30 &&
        data.days is list && data.days.size() <= 366 &&
        data.createdAt is number;
    }

    function isValidExam(data, userId, examId) {
      return data.keys().hasAll(['id', 'userId', 'name', 'examDate', 'chapters', 'planDays', 'createdAt', 'updatedAt']) &&
        data.id is string && data.id == examId && data.id.size() <= 128 &&
        data.userId is string && data.userId == userId && data.userId.size() <= 128 &&
        data.name is string && data.name.size() <= 200 &&
        data.examDate is string && data.examDate.size() <= 32 &&
        data.chapters is list && data.chapters.size() <= 150 &&
        data.planDays is list && data.planDays.size() <= 366 &&
        data.createdAt is number &&
        data.updatedAt is number;
    }

    function isValidCard(data, userId, cardId) {
      return data.keys().hasAll(['id', 'userId', 'type', 'front', 'back', 'subject', 'chapter', 'ease', 'interval', 'repetitions', 'dueAt', 'wrongCount', 'correctCount', 'createdAt', 'updatedAt']) &&
        data.id is string && data.id == cardId && data.id.size() <= 128 &&
        data.userId is string && data.userId == userId && data.userId.size() <= 128 &&
        data.type in ['flashcard', 'quiz'] &&
        data.front is string && data.front.size() <= 2000 &&
        data.back is string && data.back.size() <= 5000 &&
        data.subject is string && data.subject.size() <= 120 &&
        data.chapter is string && data.chapter.size() <= 160 &&
        data.ease is number &&
        data.interval is number &&
        data.repetitions is number &&
        data.dueAt is number &&
        (!('lastGrade' in data) || data.lastGrade in ['again', 'hard', 'good', 'easy']) &&
        (!('lastReviewedAt' in data) || data.lastReviewedAt is number) &&
        data.wrongCount is number &&
        data.correctCount is number &&
        data.createdAt is number &&
        data.updatedAt is number;
    }

    function isValidPlaylistCourse(data, userId, courseId) {
      return data.keys().hasAll(['id', 'userId', 'title', 'modules', 'completedVideoIds', 'finalTestQuestions', 'progressPercent', 'createdAt', 'updatedAt']) &&
        data.id is string && data.id == courseId && data.id.size() <= 128 &&
        data.userId is string && data.userId == userId && data.userId.size() <= 128 &&
        data.title is string && data.title.size() <= 240 &&
        data.modules is list && data.modules.size() <= 100 &&
        data.completedVideoIds is list && data.completedVideoIds.size() <= 200 &&
        data.finalTestQuestions is list && data.finalTestQuestions.size() <= 50 &&
        data.progressPercent is number &&
        data.createdAt is number &&
        data.updatedAt is number;
    }

    function isValidAnswerEvaluation(data, userId, evalId) {
      return data.keys().hasAll(['id', 'userId', 'question', 'maxMarks', 'studentAnswer', 'marksAwarded', 'examinerFeedback', 'modelTopperAnswer', 'createdAt']) &&
        data.id is string && data.id == evalId && data.id.size() <= 128 &&
        data.userId is string && data.userId == userId && data.userId.size() <= 128 &&
        data.question is string && data.question.size() <= 2000 &&
        data.maxMarks is number &&
        data.studentAnswer is string && data.studentAnswer.size() <= 15000 &&
        data.marksAwarded is number &&
        data.examinerFeedback is string && data.examinerFeedback.size() <= 4000 &&
        data.modelTopperAnswer is string && data.modelTopperAnswer.size() <= 8000 &&
        data.createdAt is number;
    }

    function isValidQuizBattle(data, battleId) {
      return data.keys().hasAll(['id', 'title', 'topic', 'creatorName', 'questions', 'entries', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'title', 'topic', 'creatorName', 'questions', 'entries', 'createdAt', 'updatedAt']) &&
        data.id is string && data.id == battleId && data.id.size() <= 128 &&
        data.title is string && data.title.size() <= 200 &&
        data.topic is string && data.topic.size() <= 160 &&
        data.creatorName is string && data.creatorName.size() <= 100 &&
        data.questions is list && data.questions.size() <= 20 &&
        data.entries is list && data.entries.size() <= 100 &&
        data.createdAt is number &&
        data.updatedAt is number;
    }

    function isValidMorningBrief(data, userId, briefDate) {
      return data.keys().hasAll(['id', 'userId', 'briefDate', 'createdAt']) &&
        data.id is string && data.id == briefDate && data.id.size() <= 128 &&
        data.userId is string && data.userId == userId && data.userId.size() <= 128 &&
        data.briefDate is string && data.briefDate.size() <= 32 &&
        data.createdAt is number;
    }

    function isValidPublicArtifact(data, artifactId) {
      return data.keys().hasAll(['id', 'ownerId', 'authorName', 'title', 'summary', 'content', 'category', 'visibility', 'outputType', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'ownerId', 'authorName', 'title', 'summary', 'content', 'category', 'visibility', 'outputType', 'tags', 'createdAt', 'updatedAt']) &&
        data.id is string && data.id == artifactId && data.id.size() <= 128 &&
        data.ownerId is string && data.ownerId == request.auth.uid && data.ownerId.size() <= 128 &&
        data.authorName is string && data.authorName.size() <= 100 &&
        data.title is string && data.title.size() <= 200 &&
        data.summary is string && data.summary.size() <= 500 &&
        data.content is string && data.content.size() <= 32000 &&
        data.category is string && data.category.size() <= 50 &&
        data.visibility in ['public', 'private'] &&
        data.outputType is string && data.outputType.size() <= 50 &&
        (!('tags' in data) || (data.tags is list && data.tags.size() <= 10)) &&
        data.createdAt is number &&
        data.updatedAt is number;
    }

    function isValidUserDailyQuota(data, userId, quotaDate) {
      return data.keys().hasAll(['quotaDate', 'userId', 'plan', 'messagesUsed', 'filesUploaded', 'searchesUsed', 'deepResearchUsed', 'pdfStudyUsed', 'tokensUsed', 'updatedAt']) &&
        data.keys().hasOnly(['quotaDate', 'userId', 'plan', 'messagesUsed', 'filesUploaded', 'searchesUsed', 'deepResearchUsed', 'pdfStudyUsed', 'tokensUsed', 'updatedAt']) &&
        data.quotaDate is string && data.quotaDate == quotaDate && data.quotaDate.size() <= 32 &&
        data.userId is string && data.userId == userId && data.userId.size() <= 128 &&
        data.plan in ['free', 'spark', 'fire'] &&
        data.messagesUsed is number && data.messagesUsed >= 0 &&
        data.filesUploaded is number && data.filesUploaded >= 0 &&
        data.searchesUsed is number && data.searchesUsed >= 0 &&
        data.deepResearchUsed is number && data.deepResearchUsed >= 0 &&
        data.pdfStudyUsed is number && data.pdfStudyUsed >= 0 &&
        data.tokensUsed is number && data.tokensUsed >= 0 &&
        data.updatedAt is number;
    }

    function isValidLocationPreference(data, userId, prefId) {
      return data.keys().hasAll(['id', 'userId', 'locationEnabled', 'mode', 'persistPreciseLocation', 'updatedAt']) &&
        data.keys().hasOnly([
          'id', 'userId', 'locationEnabled', 'mode',
          'preferredCity', 'preferredRegion', 'preferredCountry', 'preferredCountryCode', 'preferredTimezone',
          'preferredLatitude', 'preferredLongitude', 'persistPreciseLocation', 'updatedAt'
        ]) &&
        isValidId(data.id) && data.id == prefId &&
        isValidId(data.userId) && data.userId == userId &&
        data.locationEnabled is bool &&
        data.mode in ['precise', 'approximate', 'manual', 'disabled'] &&
        data.persistPreciseLocation is bool &&
        (!('preferredCity' in data) || (data.preferredCity is string && data.preferredCity.size() <= 120)) &&
        (!('preferredRegion' in data) || (data.preferredRegion is string && data.preferredRegion.size() <= 120)) &&
        (!('preferredCountry' in data) || (data.preferredCountry is string && data.preferredCountry.size() <= 120)) &&
        (!('preferredCountryCode' in data) || (data.preferredCountryCode is string && data.preferredCountryCode.size() <= 8)) &&
        (!('preferredTimezone' in data) || (data.preferredTimezone is string && data.preferredTimezone.size() <= 80)) &&
        (!('preferredLatitude' in data) || (data.preferredLatitude is number && data.preferredLatitude >= -90 && data.preferredLatitude <= 90)) &&
        (!('preferredLongitude' in data) || (data.preferredLongitude is number && data.preferredLongitude >= -180 && data.preferredLongitude <= 180)) &&
        data.updatedAt is number;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming(), userId);
      allow update: if resource != null && isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming(), userId) &&
        incoming().uid == existing().uid &&
        (!('createdAt' in existing()) || incoming().createdAt == existing().createdAt) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt', 'email']);
      allow delete: if isOwner(userId) && isValidId(userId);

      match /threads/{threadId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(threadId);
        allow list: if isOwner(userId) && existing().userId == request.auth.uid;
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(threadId) && isValidChatThread(incoming(), userId, threadId);
        allow update: if resource != null && isOwner(userId) && isValidId(userId) && isValidId(threadId) && isValidChatThread(incoming(), userId, threadId) &&
          incoming().id == existing().id &&
          incoming().userId == existing().userId &&
          incoming().createdAt == existing().createdAt &&
          incoming().diff(existing()).affectedKeys().hasOnly(['title', 'messages', 'updatedAt', 'preview']);
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(threadId);
      }

      match /bookmarks/{bookmarkId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(bookmarkId);
        allow list: if isOwner(userId) && existing().userId == request.auth.uid;
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(bookmarkId) && isValidSavedBookmark(incoming(), userId, bookmarkId);
        allow update: if resource != null && isOwner(userId) && isValidId(userId) && isValidId(bookmarkId) && isValidSavedBookmark(incoming(), userId, bookmarkId) &&
          incoming().id == existing().id &&
          incoming().userId == existing().userId &&
          incoming().savedAt == existing().savedAt &&
          incoming().diff(existing()).affectedKeys().hasOnly(['snippet', 'threadTitle']);
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(bookmarkId);
      }

      match /study_sessions/{sessionId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(sessionId);
        allow list: if isOwner(userId) && isValidId(userId);
        allow create, update: if isOwner(userId) && isValidId(userId) && isValidId(sessionId);
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(sessionId);
      }

      match /deep_research/{researchId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(researchId);
        allow list: if isOwner(userId) && isValidId(userId);
        allow create, update: if isOwner(userId) && isValidId(userId) && isValidId(researchId);
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(researchId);
      }

      match /vault_items/{itemId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(itemId);
        allow list: if isOwner(userId) && existing().userId == request.auth.uid;
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(itemId) && isValidVaultItem(incoming(), userId, itemId);
        allow update: if resource != null && isOwner(userId) && isValidId(userId) && isValidId(itemId) && isValidVaultItem(incoming(), userId, itemId) &&
          incoming().id == existing().id &&
          incoming().userId == existing().userId &&
          incoming().createdAt == existing().createdAt &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'type', 'title', 'subject', 'chapter', 'tags', 'sourceUrl',
            'timestamps', 'content', 'summary', 'collectionId', 'sourceType',
            'isPinned', 'relatedItemIds', 'sageNote', 'organizedBySage',
            'lastReviewedAt', 'updatedAt'
          ]);
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(itemId);
      }

      match /vault_threads/{threadId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(threadId);
        allow list: if isOwner(userId) && existing().userId == request.auth.uid;
        allow create, update: if isOwner(userId) && isValidId(userId) && isValidId(threadId);
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(threadId);

        match /comments/{commentId} {
          allow get: if isOwner(userId) && isValidId(userId) && isValidId(commentId);
          allow list: if isOwner(userId);
          allow create, update: if isOwner(userId) && isValidId(userId) && isValidId(commentId);
          allow delete: if isOwner(userId) && isValidId(userId) && isValidId(commentId);
        }
      }

      match /vault_memory/{memoryId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(memoryId);
        allow list: if isOwner(userId) && existing().userId == request.auth.uid;
        allow create, update: if isOwner(userId) && isValidId(userId) && isValidId(memoryId);
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(memoryId);
      }

      match /agent_memory/{agentId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(agentId);
        allow list: if isOwner(userId) && existing().userId == request.auth.uid;
        allow create, update: if isOwner(userId) && isValidId(userId) && isValidId(agentId) && isValidAgentMemory(incoming(), userId, agentId);
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(agentId);
      }

      match /agent_usage/{usageId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(usageId);
        allow list: if isOwner(userId) && existing().userId == request.auth.uid;
        allow create, update: if isOwner(userId) && isValidId(userId) && isValidId(usageId) && isValidAgentUsage(incoming(), userId, usageId);
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(usageId);
      }

      match /recall_cards/{cardId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(cardId);
        allow list: if isOwner(userId) && existing().userId == request.auth.uid;
        allow create, update: if isOwner(userId) && isValidId(userId) && isValidId(cardId) && isValidRecallCard(incoming(), userId, cardId);
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(cardId);
      }

      match /study_plans/{planId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(planId);
        allow list: if isOwner(userId) && existing().userId == request.auth.uid;
        allow create, update: if isOwner(userId) && isValidId(userId) && isValidId(planId) && isValidStudyPlan(incoming(), userId, planId);
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(planId);
      }

      match /exams/{examId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(examId);
        allow list: if isOwner(userId) && existing().userId == request.auth.uid;
        allow create, update: if isOwner(userId) && isValidId(userId) && isValidId(examId) && isValidExam(incoming(), userId, examId);
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(examId);
      }

      match /cards/{cardId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(cardId);
        allow list: if isOwner(userId) && existing().userId == request.auth.uid;
        allow create, update: if isOwner(userId) && isValidId(userId) && isValidId(cardId) && isValidCard(incoming(), userId, cardId);
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(cardId);
      }

      match /playlist_courses/{courseId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(courseId);
        allow list: if isOwner(userId) && existing().userId == request.auth.uid;
        allow create, update: if isOwner(userId) && isValidId(userId) && isValidId(courseId) && isValidPlaylistCourse(incoming(), userId, courseId);
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(courseId);
      }

      match /answer_evaluations/{evalId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(evalId);
        allow list: if isOwner(userId) && existing().userId == request.auth.uid;
        allow create, update: if isOwner(userId) && isValidId(userId) && isValidId(evalId) && isValidAnswerEvaluation(incoming(), userId, evalId);
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(evalId);
      }

      match /morning_briefs/{briefDate} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(briefDate);
        allow list: if isOwner(userId) && existing().userId == request.auth.uid;
        allow create, update: if isOwner(userId) && isValidId(userId) && isValidId(briefDate) && isValidMorningBrief(incoming(), userId, briefDate);
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(briefDate);
      }

      match /quotas/{quotaDate} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(quotaDate);
        allow list: if isOwner(userId) && existing().userId == request.auth.uid;
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(quotaDate) && isValidUserDailyQuota(incoming(), userId, quotaDate);
        allow update: if resource != null && isOwner(userId) && isValidId(userId) && isValidId(quotaDate) && isValidUserDailyQuota(incoming(), userId, quotaDate) &&
          incoming().quotaDate == existing().quotaDate &&
          incoming().userId == existing().userId &&
          incoming().messagesUsed >= existing().messagesUsed &&
          incoming().filesUploaded >= existing().filesUploaded &&
          incoming().searchesUsed >= existing().searchesUsed &&
          incoming().deepResearchUsed >= existing().deepResearchUsed &&
          incoming().pdfStudyUsed >= existing().pdfStudyUsed &&
          incoming().tokensUsed >= existing().tokensUsed;
        allow delete: if false;
      }

      match /preferences/{prefId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(prefId);
        allow list: if isOwner(userId) && existing().userId == request.auth.uid;
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(prefId) && isValidLocationPreference(incoming(), userId, prefId);
        allow update: if resource != null && isOwner(userId) && isValidId(userId) && isValidId(prefId) && isValidLocationPreference(incoming(), userId, prefId) &&
          incoming().id == existing().id &&
          incoming().userId == existing().userId;
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(prefId);
      }
    }

    match /shared_threads/{shareId} {
      allow get: if isValidId(shareId);
      allow list: if false;
      allow create: if isValidId(shareId) && isValidSharedThread(incoming(), shareId);
      allow update: if false;
      allow delete: if resource != null && isSignedIn() && isValidId(shareId) && existing().ownerId == request.auth.uid;
    }

    match /public_artifacts/{artifactId} {
      allow get: if isValidId(artifactId) && resource != null && (existing().visibility == 'public' || (isSignedIn() && existing().ownerId == request.auth.uid));
      allow list: if existing().visibility == 'public' || (isSignedIn() && existing().ownerId == request.auth.uid);
      allow create: if isSignedIn() && isValidId(artifactId) && isValidPublicArtifact(incoming(), artifactId);
      allow update: if resource != null && isSignedIn() && isValidId(artifactId) && existing().ownerId == request.auth.uid && isValidPublicArtifact(incoming(), artifactId) &&
        incoming().id == existing().id &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['authorName', 'title', 'summary', 'content', 'category', 'visibility', 'outputType', 'tags', 'updatedAt']);
      allow delete: if resource != null && isSignedIn() && isValidId(artifactId) && existing().ownerId == request.auth.uid;
    }

    match /quiz_battles/{battleId} {
      allow get: if isValidId(battleId);
      allow list: if false;
      allow create: if isValidId(battleId) && isValidQuizBattle(incoming(), battleId);
      allow update: if resource != null && isValidId(battleId) && isValidQuizBattle(incoming(), battleId) &&
        incoming().id == existing().id &&
        incoming().title == existing().title &&
        incoming().topic == existing().topic &&
        incoming().creatorName == existing().creatorName &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['entries', 'updatedAt']);
      allow delete: if false;
    }
  }
}
