# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# FIREBASE_PROJECT_ID: Expected Firebase Project ID for cryptographic JWT verification.
FIREBASE_PROJECT_ID="sustained-chiller-36tp2"

# FIREBASE_SERVICE_ACCOUNT_JSON: Optional service account JSON (raw or base64) for Firebase Admin SDK in staging/production.
FIREBASE_SERVICE_ACCOUNT_JSON=""

# FIREBASE_CHECK_REVOKED: When "true", verifyIdToken checks whether the user's Firebase refresh token was revoked.
FIREBASE_CHECK_REVOKED="false"

# REQUIRE_AUTH_FOR_CHAT: Set to "true" to enforce mandatory Firebase Bearer token auth on /api/chat, /api/summarize, /api/tts, etc.
REQUIRE_AUTH_FOR_CHAT="false"

# TRUST_PROXY: Express trust proxy configuration ("1" on Cloud Run behind Google Front End, "false" when direct).
TRUST_PROXY="1"

# RATE_LIMIT_FAIL_MODE: Behavior when primary shared rate limit store fails ("fallback" for emergency in-memory window, "closed" for 503).
RATE_LIMIT_FAIL_MODE="fallback"

# REDIS_URL: Optional Redis connection URI for distributed atomic Lua sliding-window rate limiting across multi-instance Cloud Run deployments.
REDIS_URL=""

# Optional server-side API keys for extended LLM, TTS, and Treg search integrations
BEAT_API_KEY=""
APINEX_API_KEY=""
RUMIK_API_KEY=""
SMALLEST_API_KEY=""
TREG_TOKEN=""
TREG_ORG="syntrofoi"
TINYFISH_API_KEY=""
FLOVIA_API_KEY=""
FLOVIA_MCP_URL="https://api.flovia.dev/mcp"

