    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/refund",
      "destination": "/refund.html"
    },
    {
      "source": "/refunds",
      "destination": "/refund.html"
    },
    {
      "source": "/contact",
      "destination": "/contact.html"
    },
    {
      "source": "/acceptable-use",
      "destination": "/acceptable-use.html"
    },
    {
      "source": "/cookies",
      "destination": "/cookies.html"
    },
    {
      "source": "/study",
      "destination": "/study.html"
    },
    {
      "source": "/study/:path*",
      "destination": "/study.html"
    },
    {
      "source": "/discover",
      "destination": "/discover.html"
    },
    {
      "source": "/research",
      "destination": "/research.html"
    },
    {
      "source": "/pricing",
      "destination": "/pricing.html"
    },
    {
      "source": "/settings",
      "destination": "/settings.html"
    },
    {
      "source": "/account",
      "destination": "/account.html"
    },
    {
      "source": "/login",
      "destination": "/login.html"
    },
    {
      "source": "/signup",
      "destination": "/signup.html"
    },
    {
      "source": "/chat",
      "destination": "/chat.html"
    },
    {
      "source": "/chat/:path*",
      "destination": "/chat.html"
    },
    {
      "source": "/vault",
      "destination": "/index.html"
    },
    {
      "source": "/vault/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/r/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/invite/:code*",
      "destination": "/index.html"
    },
    {
      "source": "/s/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/share/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/p/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}